# CivicGuard Autopilot Configuration

CIVICGUARD_ENV=development
CIVICGUARD_PORT=8000
CIVICGUARD_HOST=127.0.0.1
CIVICGUARD_MODE=simulation  # simulation | k8s_lab
CIVICGUARD_REAL_ACTIONS=false
CIVICGUARD_AUDIT_SECRET=civicguard-integrity-secret-local-change-me
CIVICGUARD_DATA_DIR=./data
CIVICGUARD_SQLITE_PATH=./data/civicguard.db

# Safety & Canary Policies
CIVICGUARD_CANARY_SAMPLE_WINDOWS=3
CIVICGUARD_CANARY_REGRESSION_THRESHOLD=0.01
CIVICGUARD_RCA_CONFIDENCE_THRESHOLD=70.0
CIVICGUARD_MAX_BLAST_RADIUS=3
CIVICGUARD_EVIDENCE_TTL_SECONDS=120

